{
  "expo": {
    "name": "Financeiro e Frota Logística",
    "slug": "financeiro-frota-logistica",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "frotafinanceiro",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "android": {
      "package": "com.tempesta.frotafinanceiro",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFC107"
      },
      "versionCode": 1
    },
    "ios": {
      "bundleIdentifier": "com.tempesta.frotafinanceiro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "O app precisa acessar suas fotos para anexar documentos.",
          "cameraPermission": "O app precisa da câmera para fotografar documentos."
        }
      ]
    ],
    "extra": {
      "supabaseUrl": "SUA_SUPABASE_URL_AQUI",
      "supabaseAnonKey": "SUA_SUPABASE_ANON_KEY_AQUI",
      "googleExpoClientId": "SEU_GOOGLE_CLIENT_ID_EXPO",
      "googleAndroidClientId": "SEU_GOOGLE_CLIENT_ID_ANDROID",
      "googleIosClientId": "SEU_GOOGLE_CLIENT_ID_IOS"
    },
    "icon": "./assets/icon.png",
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./public/favicon.png",
      "name": "Financeiro e Frota Logística",
      "shortName": "Frota Fin.",
      "lang": "pt-BR",
      "themeColor": "#FFC107",
      "backgroundColor": "#121212",
      "display": "standalone",
      "orientation": "portrait"
    }
  }
}
